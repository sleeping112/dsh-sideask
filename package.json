{
  "name": "dsh-sideask",
  "version": "0.6.1",
  "description": "A floating side-conversation window for DeepSeek Harness: reads the current conversation read-only, answers with citations in its own thread, and writes back to the main composer only on an explicit click.",
  "type": "module",
  "main": "lib/host/index.js",
  "exports": {
    ".": "./lib/host/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "docs",
    "examples",
    "assets",
    "screenshots.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sleeping112/dsh-sideask.git"
  },
  "homepage": "https://github.com/sleeping112/dsh-sideask#readme",
  "bugs": {
    "url": "https://github.com/sleeping112/dsh-sideask/issues"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "旁问（Side Ask）",
    "summary": "在主对话旁开一个悬浮轻对话：只读当前上下文提问、回答带引用、显式插入回主对话，绝不污染主线程。",
    "categories": [
      "Web UI",
      "对话增强"
    ],
    "surfaces": [
      "host",
      "web"
    ],
    "permissions": {
      "network": []
    }
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "side-ask",
    "floating-assistant",
    "web-ui"
  ],
  "author": "dsh-sideask contributors",
  "license": "MIT",
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "packageManager": "pnpm@11.28.5",
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "node scripts/build.mjs && node --test",
    "test:memory": "node scripts/build.mjs && node scripts/memory-check.mjs",
    "dev": "node scripts/build.mjs --watch",
    "check": "node scripts/check.mjs",
    "preflight": "node scripts/preflight.mjs",
    "prepublishOnly": "npm run typecheck && npm test && node scripts/check.mjs && npm run preflight && node scripts/memory-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.7.0"
  }
}
